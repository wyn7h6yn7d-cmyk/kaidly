    "test:db": "supabase test db",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:db && npm run build",
    "dev:local": "node scripts/dev-local.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
